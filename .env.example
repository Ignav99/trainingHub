# ============================================================================
# TRAININGHUB PRO - VARIABLES DE ENTORNO
# ============================================================================
# Copiar este archivo a .env y rellenar con tus valores
# ============================================================================

# ============================================================================
# SUPABASE (Obligatorio)
# ============================================================================
# Obtener de: https://supabase.com/dashboard/project/[tu-proyecto]/settings/api

# URL del proyecto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co

# Clave anónima (pública, para frontend)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx

# Clave de servicio (privada, solo backend)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx

# ============================================================================
# BACKEND (FastAPI)
# ============================================================================

# Clave secreta para JWT (generar con: openssl rand -hex 32)
SECRET_KEY=tu-clave-secreta-super-segura-de-al-menos-32-caracteres

# Modo debug (true/false)
DEBUG=true

# Host y puerto
HOST=0.0.0.0
PORT=8000

# URLs permitidas para CORS (separadas por coma)
CORS_ORIGINS=http://localhost:3000,https://tu-dominio.com

# ============================================================================
# FRONTEND (Next.js)
# ============================================================================

# URL del backend API
NEXT_PUBLIC_API_URL=http://localhost:8000/v1

# ============================================================================
# OPCIONAL: Scraping RFAF (Render suele estar bloqueado sin proxy)
# ============================================================================
# SCRAPERAPI_KEY=...           # https://www.scraperapi.com (country=es)
# RFAF_HTTPS_PROXY=http://user:pass@host:port
# RFAF_USE_CURL_CFFI=true

# ============================================================================
# OPCIONAL: Claude API para recomendaciones avanzadas
# ============================================================================
# ANTHROPIC_API_KEY=sk-ant-xxxxx

# ============================================================================
# OPCIONAL: Cloudflare R2 — recortes de revisión (~100MB × 7–10 por partido)
# ============================================================================
# Si las 5 están en el API de Render, el navegador sube directo a R2 (no al tope
# de 50MB de Supabase Free). Sin estas vars se sigue usando Supabase Storage.
#
# Bucket CORS (AllowedMethods PUT,GET,HEAD; AllowedHeaders *; MaxAge 3600):
#   https://traininghub-frontend-eu.onrender.com
#   http://localhost:3000
#
# R2_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# R2_BUCKET=revision-clips
# R2_PUBLIC_BASE_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev

# ============================================================================
# OPCIONAL: Storage externo (si no usas Supabase Storage)
# ============================================================================
# STORAGE_BUCKET_URL=https://storage.ejemplo.com
